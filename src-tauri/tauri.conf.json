{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "goplexa",
  "version": "0.1.0",
  "identifier": "com.somgo.goplexa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goplexa",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "url": "http://localhost:1420/index.html"
      },
      {
        "label": "command",
        "title": "Command",
        "width": 600,
        "height": 60,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "url": "http://localhost:1420/command.html"
      },
      {
        "label": "suggestion",
        "title": "Suggestion",
        "width": 200,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": true,
        "url": "http://localhost:1420/suggestion.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
